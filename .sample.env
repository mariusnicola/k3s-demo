# Starting point for the .env files of this project. Do not use this file as it is.
# Each block below belongs in one file, named in the block header. Copy only that block.
# A line that starts with "#" is a comment. Real .env files are ignored by git, this file is not.
# A value in angle brackets, like <HOST_IP>, is yours to replace.
# setup.md explains how to generate each secret.

# ---------------------------------------------------------------
# deploy/app/.env
# Read by the API, Worker, Dispatcher, Live and Nightly pods and by the Monitor and the Line.
# If this file does not exist, setup creates the first five keys. If it exists, every key
# below must hold a value, a blank one stops setup.
# ---------------------------------------------------------------
# Private signing key of the sign-in cookie: base64 of a PKCS8 DER key (P-256).
JWT_PRIVATE_KEY=<generate, see setup.md>
# Matching public key: base64 of an SPKI DER key.
JWT_PUBLIC_KEY=<generate, see setup.md>
# Shared secret for calls between services.
INTERNAL_TOKEN=<64 hex characters>
# Secret the Line uses to sign in to the API.
LINE_MACHINE_TOKEN=<64 hex characters>
# Secret the Monitor uses to sign in to the API.
MONITOR_MACHINE_TOKEN=<64 hex characters>
# Cosmos DB emulator. Setup does not make this one. Use your <HOST_IP>.
# Copy the emulator key from https://learn.microsoft.com/en-us/azure/cosmos-db/emulator .
COSMOS_CONNECTION=AccountEndpoint=https://<HOST_IP>:8091/;AccountKey=<COSMOS_EMULATOR_KEY>;DisableServerCertificateValidation=True;
# MongoDB. Leave blank: setup fills it from MONGO_PASSWORD in deploy/mongo/.env.
MONGO_CONNECTION=
# Service Bus emulator. Setup does not make this one. Use your <HOST_IP>.
SERVICEBUS_CONNECTION=Endpoint=sb://<HOST_IP>:5682;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# ---------------------------------------------------------------
# deploy/mongo/.env
# Read by deploy/mongo/docker-compose.yaml and by setup. Blank values are generated.
# ---------------------------------------------------------------
# Password of the MongoDB user "admin".
MONGO_PASSWORD=
# Password of the MongoDB user "monitor", which can only use the database "monitor".
MONGO_MONITOR_PASSWORD=
# Connection string of the "monitor" user. Setup builds it when blank.
MONGO_MONITOR_CONNECTION=

# ---------------------------------------------------------------
# deploy/servicebus/.env
# Read by deploy/servicebus/docker-compose.yaml.
# If this file does not exist, setup creates it. If it exists, the value must not be blank.
# ---------------------------------------------------------------
# Password of the SQL Server that stores the Service Bus emulator data.
# SQL Server refuses weak passwords: 8 or more characters, upper and lower case, digits and a symbol.
MSSQL_SA_PASSWORD=<strong password>

# ---------------------------------------------------------------
# Written by setup into these files. Do not set them yourself.
# They are listed so you know what you will find there.
# ---------------------------------------------------------------
# deploy/servicebus/.env, deploy/cosmos/.env, deploy/mongo/.env, deploy/monitor/.env,
# deploy/line/.env, deploy/node1/.env: CPU and memory limits from deploy/caps.json.
#   CAP_SERVICEBUS_CPU, CAP_SERVICEBUS_MEMORY, CAP_SQL_CPU, CAP_SQL_MEMORY   (servicebus)
#   CAP_COSMOS_CPU, CAP_COSMOS_MEMORY                                         (cosmos)
#   CAP_MONGO_CPU, CAP_MONGO_MEMORY                                           (mongo)
#   CAP_MONITOR_CPU, CAP_MONITOR_MEMORY                                       (monitor)
#   CAP_LINE_CPU, CAP_LINE_MEMORY                                             (line)
#   CAP_NODE1_CPU, CAP_NODE1_MEMORY                                           (node1)
# deploy/monitor/.env: DEPLOYED_COMMIT, CHANGES_DIR, MONITOR_MACHINE_TOKEN, MONGO_CONNECTION, JWT_PUBLIC_KEY
# deploy/line/.env: LINE_IMAGE, JWT_PUBLIC_KEY, LINE_MACHINE_TOKEN
